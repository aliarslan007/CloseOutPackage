APP_NAME=COP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kill switch: when false, no customer-facing emails are sent (logged as "suppressed" instead).
CUSTOMER_EMAILS_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SSO_AUTHORIZATION_URL=
SSO_LOGOUT_URL=

AUTHCENTER_URL=
AUTHCENTER_KEY=solucomp_cop
AUTHCENTER_PM_SECRET=
SSO_REDIRECT_URL=
SSO_DEV_REDIRECT_URL=http://localhost:3000/ccms/auth/sso
SSO_PROD_REDIRECT_URL=https://solucomp.com/ccms/auth/sso

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

COP_LOGO_PATH=assets/logo.png

# SoluComp brand mark. Point this at any image and the sidebar, emails and
# generated PDFs all follow it. Falls back to the bundled asset above if the
# host is unreachable.
SOLUCOMP_LOGO_URL=https://solucomp.com/images/backgrounds/logo.png
SOLUCOMP_LOGO_CACHE_SECONDS=3600
COP_MAX_PHOTO_SIZE_MB=20
COP_REVISION_MINOR_THRESHOLD=10
COP_TEMP_PDF_TTL_HOURS=24
COP_RENDERER_VERSION=browsershot:5.4/chromium:120
# COP_DEFAULT_MARKET=

MEDIA_DISK=private
